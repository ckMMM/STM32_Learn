void App_SPI1_Init(void)
{
	// #1. 引脚重映射
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_AFIO, ENABLE);
	GPIO_PinRemapConfig(GPIO_Remap_SPI1, ENABLE);
	// pa15重映射为普通引脚
	GPIO_PinRemapConfig(GPIO_Remap_SWJ_JTAGDisable, ENABLE);

	// #2. 配置GPIO
	GPIO_InitTypeDef GPIO_InitStruct;
	// #2.1 SCK PB3 AF_PP 2MHz
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);
	GPIO_InitStruct.GPIO_Pin = GPIO_Pin_3;
	GPIO_InitStruct.GPIO_Mode = GPIO_Mode_AF_PP;
	GPIO_InitStruct.GPIO_Speed = GPIO_Speed_2MHz;
	GPIO_Init(GPIOB, &GPIO_InitStruct);

	// #2.2 MISO PB4 IPU
	GPIO_InitStruct.GPIO_Pin = GPIO_Pin_4;
	GPIO_InitStruct.GPIO_Mode = GPIO_Mode_IPU;
	GPIO_Init(GPIOB, &GPIO_InitStruct);

	// #2.3 MOSI PB5 AF_PP 2MHz
	GPIO_InitStruct.GPIO_Pin = GPIO_Pin_5;
	GPIO_InitStruct.GPIO_Mode = GPIO_Mode_AF_PP;
	GPIO_InitStruct.GPIO_Speed = GPIO_Speed_2MHz;
	GPIO_Init(GPIOB, &GPIO_InitStruct);

	// #2.4 CS PA15 OUT_PP 2MHz
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOA, ENABLE);
	GPIO_InitStruct.GPIO_Pin = GPIO_Pin_15;
	GPIO_InitStruct.GPIO_Mode = GPIO_Mode_Out_PP;
	GPIO_InitStruct.GPIO_Speed = GPIO_Speed_2MHz;
	GPIO_Init(GPIOA, &GPIO_InitStruct);
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);

	// #3. 配置SPI
	RCC_APB2PeriphClockCmd(RCC_APB2Periph_SPI1, ENABLE);
	SPI_InitTypeDef SPI_InitStruct;

	SPI_InitStruct.SPI_Mode = SPI_Mode_Master;						 // 主机模式
	SPI_InitStruct.SPI_Direction = SPI_Direction_2Lines_FullDuplex;	 // 双线全双工
	SPI_InitStruct.SPI_DataSize = SPI_DataSize_8b;					 // 数据大小8位
	SPI_InitStruct.SPI_CPOL = SPI_CPOL_Low;						 // 时钟极性
	SPI_InitStruct.SPI_CPHA = SPI_CPHA_1Edge;						 // 时钟相位
	SPI_InitStruct.SPI_FirstBit = SPI_FirstBit_MSB;					 // 数据传输从高位开始
	SPI_InitStruct.SPI_BaudRatePrescaler = SPI_BaudRatePrescaler_64; // 波特率预分频
	SPI_InitStruct.SPI_NSS = SPI_NSS_Soft;							 // NSS信号由软件管理

	SPI_Init(SPI1, &SPI_InitStruct);
	SPI_NSSInternalSoftwareConfig(SPI1, SPI_NSSInternalSoft_Set); //  软件管理NSS信号，内部拉高
}

void App_SPI_MasterTransmitReceive(SPI_TypeDef *SPIx, uint8_t *pDataTx, uint8_t *pDataRx, uint16_t size)
{
    // #1. 闭合总开关
	SPI_Cmd(SPIx, ENABLE);

	// #2. 发送第一个字节
	SPI_I2S_SendData(SPIx, pDataTx[0]);

	// #3. 同时收发，循环size-1次
	for (uint16_t i = 1; i < size; i++)
	{
		// #3.1 等待发送数据寄存器为空,发送数据
		while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_TXE) == RESET){}
		SPI_I2S_SendData(SPIx, pDataTx[i]);

		// #3.2 等待接收数据寄存器非空,接收数据
		while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_RXNE) == RESET){}
		pDataRx[i - 1] = SPI_I2S_ReceiveData(SPIx);
	}

	// #4. 接受最后一个字节
	while (SPI_I2S_GetFlagStatus(SPIx, SPI_I2S_FLAG_RXNE) == RESET){}
	pDataRx[size - 1] = SPI_I2S_ReceiveData(SPIx);

	// #5. 断开总开关
	SPI_Cmd(SPIx, DISABLE);
}

void App_W25Q64_SaveByte(uint8_t Byte)
{
	// #1. 写使能
	uint8_t buffer[10];
	buffer[0] = 0x06; 

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1);// 发送写使能指令

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中

	// #2. 扇区擦除
	buffer[0] = 0x20;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 4);// 发送扇区擦除指令

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中

	// #3. 等待空闲
	while (1)
	{
		// #3.1 读状态寄存器
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

		buffer[0] = 0x05;
		App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1);// 写0x05指令，读取状态寄存器
		buffer[0] = 0xff;
		App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1);// 发送读状态寄存器指令

		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中

		if ((buffer[0] & 0x01) == 0)break;

	}

	// #4. 写使能
	buffer[0] = 0x06;

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1); // 发送写使能指令

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中

	// #5. 页编程
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

	buffer[0] = 0x02;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;
	buffer[4] = Byte;

	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 5);// 发送页编程指令

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET);	 // 取消选中

	// #6. 等待空闲
	while (1)
	{
		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

		buffer[0] = 0x05;
		App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1); // 写0x05指令，读取状态寄存器
		buffer[0] = 0xff;
		App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1); // 发送读状态寄存器指令

		GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中

		if ((buffer[0] & 0x01) == 0)
			break;
	}
}

uint8_t App_W25Q64_LoadByte(void)
{
	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_RESET); // 选中

	uint8_t buffer[10];
	buffer[0] = 0x03;
	buffer[1] = 0x00;
	buffer[2] = 0x00;
	buffer[3] = 0x00;
	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 4);// 发送读数据指令
	buffer[0] = 0xff;
	App_SPI_MasterTransmitReceive(SPI1, buffer, buffer, 1);// 发送读数据指令

	GPIO_WriteBit(GPIOA, GPIO_Pin_15, Bit_SET); // 取消选中
	return buffer[0];
}
