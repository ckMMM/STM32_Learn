void My_SoftwareI2C_Init(void)
{
	sic2.SCL_GPIOx = GPIOB;
	sic2.SCL_GPIO_Pin = GPIO_Pin_6;
	sic2.SDA_GPIOx = GPIOB;
	sic2.SDA_GPIO_Pin = GPIO_Pin_7;

	My_SI2C_Init(&sic2);
}

int i2c_write_byte(uint8_t addr, const uint8_t *pdata, uint16_t size)
{
	return My_SI2C_SendBytes(&sic2, addr, pdata, size);
}

void My_OLED_Init(void)
{
	OLED_InitTypeDef OLED_InitStruct; // OLED初始化结构体

	OLED_InitStruct.i2c_write_cb = i2c_write_byte; // 设置i2c写数据回调函数

	OLED_Init(&oled, &OLED_InitStruct); // 初始化OLED
}
